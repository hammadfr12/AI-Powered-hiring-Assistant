# ---------------------------------------------------------------------------
# AI-Powered Hiring Assistant — configuration example
#
# Copy to `.env` and edit.  Every value below has a working default, so an
# empty `.env` (or no `.env` at all) runs the full application locally with no
# credentials and no cost.
#
# NEVER commit `.env`.  It is listed in .gitignore.
# ---------------------------------------------------------------------------

# --- Provider credentials --------------------------------------------------
# Leave blank to run entirely locally.  The app detects a missing key and
# falls back to local models automatically, recording the fallback in the UI.
OPENAI_API_KEY=
# Optional: point at an OpenAI-compatible gateway instead of api.openai.com
# OPENAI_BASE_URL=

# --- Embedding model -------------------------------------------------------
#   local-minilm  sentence-transformers/all-MiniLM-L6-v2  (384-d, fast, default)
#   local-mpnet   sentence-transformers/all-mpnet-base-v2 (768-d, higher quality)
#   openai-small  text-embedding-3-small                  (1536-d, needs key)
#   openai-large  text-embedding-3-large                  (3072-d, needs key)
EMBEDDING_MODEL=local-minilm

# --- Generation model ------------------------------------------------------
#   extractive    quotes retrieved passages verbatim — no model, no key (default)
#   openai-mini   gpt-4o-mini  (needs key)
#   openai-4o     gpt-4o       (needs key)
GENERATION_MODEL=extractive

# Set true only if you intend to send document text to an external provider.
ALLOW_OPENAI=false

# --- Chunking --------------------------------------------------------------
# Characters per chunk and overlap carried into the next chunk.  Changing
# either invalidates the existing index, which then has to be rebuilt.
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# --- Retrieval -------------------------------------------------------------
TOP_K=6
# Minimum blended relevance score before the assistant will answer at all.
# Below this it abstains and says the documents do not contain the evidence.
MIN_RELEVANCE=0.18
MAX_CONTEXT_CHUNKS=10
EMBEDDING_BATCH_SIZE=32

# --- Ingestion -------------------------------------------------------------
MAX_UPLOAD_MB=25

# --- Provider behaviour ----------------------------------------------------
REQUEST_TIMEOUT_SECONDS=45
MAX_ANSWER_TOKENS=700

# --- Storage ---------------------------------------------------------------
# Relative paths are resolved against the project root.
DATA_DIR=data
INDEX_DIR=data/index
SYNTHETIC_DIR=data/synthetic
DB_PATH=data/hiring_assistant.sqlite3

# --- Application -----------------------------------------------------------
DEMO_MODE=true
